# Dev-mode image for the `api` service — companion to the production
# Dockerfile.api, NOT a replacement for it (that file is untouched).
#
# The idea: run `./mvnw quarkus:dev` (Quarkus's own "live coding" feature)
# instead of packaging+running a fat jar. Quarkus's dev mode recompiles
# changed Java sources and reloads them into the running JVM automatically
# — it does this LAZILY, on the next incoming HTTP request after a source
# file's mtime changes, not via a background filesystem watcher. That
# matters here because it means this even works reliably with a bind-mounted
# source tree on Docker Desktop for Mac, where inotify events across the
# host<->container boundary are known to be unreliable — a plain mtime
# check on request has no such problem. See docker-compose.dev.yml for how
# api/src gets bind-mounted into this image at runtime.
#
# Toolchain: this duplicates Dockerfile.api's "toolchain" stage (nsjail
# build deps, JDK 25, .NET SDK, netcoredbg's libdbgshim.so, Rust) rather
# than sharing it, because Docker has no cross-Dockerfile FROM/COPY
# --from — only from stages within the SAME file, or from a pre-built
# tagged image. Duplicating a single apt/toolchain layer was judged less
# risky than introducing a shared-base-image build step into this dev-only
# path. Comments trimmed vs. Dockerfile.api's originals (see that file for
# the full "why" on each toolchain choice); the packages/versions/pins here
# are kept in sync with it on purpose.
#
# sandbox-runner and static-analyzer are BAKED INTO THIS IMAGE at build
# time (their source is COPY'd, not bind-mounted) — they do NOT hot-reload.
# See tasks.md "Dockerfile por serviço com hot-reload em dev" for why: Rust
# has no equivalent of Quarkus's live coding, cargo-watch would need this
# same full toolchain rebuilt in the loop, and these two binaries change far
# less often than api/src or frontend/src. Editing sandbox/ or
# static-analyzer/ still requires `docker compose -f docker-compose.dev.yml
# build api` to pick up the change.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    flex bison \
    pkg-config \
    libprotobuf-dev protobuf-compiler \
    libnl-route-3-dev \
    libcap-dev \
    libseccomp-dev \
    git \
    curl \
    gnupg \
    ca-certificates \
    libicu-dev \
    python3 \
    maven \
    unzip \
    # uidmap: see Dockerfile.api — needed by nsjail's --uid_mapping so
    # sandboxed processes map to a real unprivileged uid, not root.
    uidmap \
    && rm -rf /var/lib/apt/lists/*

# See Dockerfile.api: newuidmap/newgidmap require /etc/subuid/subgid
# delegation even for real root. Delegates the one uid/gid (65534,
# nobody/nogroup) java.rs/csharp.rs map sandboxed executions to.
RUN echo "root:65534:1" > /etc/subuid && echo "root:65534:1" > /etc/subgid

# .NET SDK
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet \
    && rm /tmp/dotnet-install.sh
ENV PATH="/usr/share/dotnet:${PATH}"
ENV DOTNET_ROOT="/usr/share/dotnet"

# netcoredbg — only used for its bundled libdbgshim.so (csharp.rs dlopens
# it directly). linux-arm64 build, matching Dockerfile.api/sandbox/Dockerfile.
RUN curl -sSL https://github.com/Samsung/netcoredbg/releases/download/3.0.0-1006/netcoredbg-linux-arm64.tar.gz -o /tmp/netcoredbg.tar.gz \
    && mkdir -p /usr/share/netcoredbg \
    && tar -xzf /tmp/netcoredbg.tar.gz -C /usr/share/netcoredbg \
    && rm /tmp/netcoredbg.tar.gz

# nsjail — no apt package, build from source
RUN git clone --depth 1 https://github.com/google/nsjail.git /tmp/nsjail \
    && cd /tmp/nsjail && make \
    && cp nsjail /usr/local/bin/nsjail \
    && cd / && rm -rf /tmp/nsjail

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# JDK 25 — used for both Quarkus itself and the sandboxed Java path
# (java.rs hardcodes /usr/bin/java). See Dockerfile.api for why this is a
# single JDK install, not two.
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends temurin-25-jdk \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/jvm/temurin-25-jdk-* /usr/lib/jvm/jdk-25
ENV JAVA_HOME="/usr/lib/jvm/jdk-25"
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ─── sandbox-runner + jdi Debugger (baked in, NOT hot-reloaded) ───────────
# /app/jdi-driver.jar + /app/jdi-driver.jsa are not configurable —
# sandbox-runner/src/java.rs hardcodes these exact paths (DRIVER_CDS_JAR/
# DRIVER_CDS_ARCHIVE) for the driver's own classpath + CDS (Class Data
# Sharing) archive, so they have to exist regardless of dev vs. prod — same
# CDS mechanism/rationale as Dockerfile.api's identical (and much more
# thoroughly commented) build step; kept here too so dev mode doesn't
# regress just because it's a separate Dockerfile from prod.
WORKDIR /build/sandbox
COPY sandbox/ .
RUN cargo build --release \
    && mkdir -p /app /build/jdi-out /build/cds-train \
    && cp target/release/sandbox-runner /app/sandbox-runner \
    && javac -encoding UTF-8 -d /build/jdi-out jdi/Debugger.java \
    && jar cf /app/jdi-driver.jar -C /build/jdi-out . \
    && cp test-snippets/Trivial.java /build/cds-train/ \
    && javac -encoding UTF-8 -g -d /build/cds-train /build/cds-train/Trivial.java \
    && java -XX:ArchiveClassesAtExit=/app/jdi-driver.jsa \
        -cp /app/jdi-driver.jar Debugger Trivial \
        "-cp /build/cds-train -Xmx256m -XX:MaxMetaspaceSize=64m -XX:MaxDirectMemorySize=256m" \
    && test -s /app/jdi-driver.jsa

# ─── static-analyzer (baked in, NOT hot-reloaded) ─────────────────────────
WORKDIR /build/static-analyzer
COPY static-analyzer/ .
RUN cargo build --release && cp target/release/static-analyzer /app/static-analyzer

# ─── minimal, isolated rootfs per sandboxed language ──────────────────────
# Bug found this session: this Dockerfile never had this step at all, so
# `docker compose -f docker-compose.dev.yml up` built an image where
# java.rs/csharp.rs's hardcoded --chroot targets (/opt/sandbox-rootfs/java,
# /opt/sandbox-rootfs/csharp) never existed, and every Java execution failed
# with `mount('/opt/sandbox-rootfs/java' -> '/tmp/nsjail.0.root//'): No such
# file or directory` -- confirmed empirically running this exact dev stack.
# Dockerfile.api's own comment on its equivalent step claims this dev
# Dockerfile was "kept in sync" when the minimal-rootfs work landed; it
# wasn't, for this one step. Same script, same invocation, same placement
# (after the sandbox-runner/jdi-driver artifacts it stages exist at /app/...,
# see Dockerfile.api's own comment on this same RUN for the full rationale)
# -- static-analyzer isn't referenced by the script, so ordering relative to
# the block above doesn't matter, but it's kept after both artifact-producing
# blocks for the same "reads already-built artifacts" reasoning.
COPY sandbox/build-minimal-rootfs.sh /tmp/build-minimal-rootfs.sh
RUN bash /tmp/build-minimal-rootfs.sh /opt/sandbox-rootfs && rm /tmp/build-minimal-rootfs.sh

# ─── api: pre-warm the Maven dependency cache only ────────────────────────
# api/src is intentionally NOT copied here — it's bind-mounted at runtime
# (docker-compose.dev.yml) so edits are visible without a rebuild. Copying
# just pom.xml/.mvn/mvnw and running dependency:go-offline here means the
# ~/.m2 cache baked into this layer already has Quarkus's (many) build-time
# deps, so the first `quarkus:dev` after `docker compose up` doesn't have to
# download the whole internet before it can start.
WORKDIR /build/api
COPY api/pom.xml .
COPY api/.mvn .mvn
COPY api/mvnw .
RUN ./mvnw -q -B dependency:go-offline || true

ENV SANDBOX_RUNNER_BINARY_PATH="/app/sandbox-runner"
ENV STATIC_ANALYZER_BINARY_PATH="/app/static-analyzer"

EXPOSE 8080

# No CMD: docker-compose.dev.yml supplies `./mvnw quarkus:dev`, run against
# the bind-mounted api/ tree.
