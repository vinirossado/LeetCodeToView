# Pi variant of .ci/leetcodeview-api.service — same privilege set (nsjail's
# --cgroupns=host / --security-opt requirements don't change with the host,
# see that file's own header comment for the full validated reasoning), but:
#   - no registry pull: builds/tags the image LOCALLY on the Pi (see
#     .ci/deploy-pi.sh) as `leetcodeview:latest`, no `pizito:5001/` prefix —
#     the Pi is a local test environment, not pizito (the real VPS); nothing
#     has been pushed to pizito's registry from here.
#   - `--network leetcodeview-net`, a plain user-defined BRIDGE network
#     (`docker network create leetcodeview-net`), not the `proxy_net`
#     Swarm overlay — the Pi's frontend is ALSO a plain container (see
#     .ci/leetcodeview-fe.pi.service), not a Swarm service, so there is no
#     Swarm on this host at all (see .ci/readme.md's "Pi" section for why).
#   - `-p 8080:8080` published directly (no reverse proxy/Swarm ingress
#     doing that on the Pi).
#   - no EnvironmentFile — the Pi doesn't have pizito's
#     /mnt/ssd/@docker/leetcodeview/.env; add one here if the Pi ever needs
#     its own secrets/config beyond DOTNET_GCHeapHardLimit below.
[Unit]
Description=code2complexity API (Pi, local test — no Swarm, no registry, see this file's own header comment)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0

ExecStartPre=-/usr/bin/docker rm -f leetcodeview-api

ExecStart=/usr/bin/docker run --rm --name leetcodeview-api \
  --cap-drop=ALL \
  --cap-add=SYS_ADMIN \
  --cap-add=SYS_CHROOT \
  --cap-add=NET_ADMIN \
  --cap-add=SYS_RESOURCE \
  --cap-add=SETUID \
  --cap-add=SETGID \
  --cap-add=DAC_OVERRIDE \
  --cgroupns=host \
  --security-opt systempaths=unconfined \
  --security-opt seccomp=unconfined \
  -v /sys/fs/cgroup:/sys/fs/cgroup:rw \
  --network leetcodeview-net \
  -p 8080:8080 \
  -e DOTNET_GCHeapHardLimit=0x8000000 \
  leetcodeview:latest

ExecStop=/usr/bin/docker stop -t 15 leetcodeview-api

[Install]
WantedBy=multi-user.target
