# Production image for the frontend: Angular build served by nginx,
# reverse-proxying /executions and /analysis to the `leetcodeview-api`
# container (see .ci/nginx.frontend.conf) — different from
# frontend/Dockerfile (the local docker-compose image) because that one's
# nginx.conf hardcodes `proxy_pass http://api:8080`, a compose-only DNS
# alias that doesn't exist here.

FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npx ng build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
COPY .ci/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:80/ || exit 1
