# Frontend image for the Pi's Swarm-free deploy — identical to
# .ci/Dockerfile.frontend except for which nginx config gets baked in (see
# .ci/nginx.frontend.pi.conf's own header comment for why it needs a
# different upstream hostname than the Swarm one). Everything else
# (Angular build steps, HEALTHCHECK) is unchanged — mirror any real change
# there into both files.

FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npx ng build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
COPY .ci/nginx.frontend.pi.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:80/ || exit 1
