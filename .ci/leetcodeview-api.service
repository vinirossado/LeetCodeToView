# systemd unit for the `api` container (Quarkus API + sandbox-runner +
# static-analyzer, one combined image — see .ci/Dockerfile). Plain
# `docker run`, not a Swarm service — nsjail (the process this container's
# own Quarkus API shells out to per execution) needs `--cgroupns=host` and
# `--security-opt systempaths=unconfined`/`seccomp=unconfined` to actually
# isolate untrusted code on a real Linux host, and Docker Swarm has no way
# to grant either (confirmed empirically: `cgroup: host` is rejected at
# stack-file schema validation, `security_opt` is silently ignored) — see
# spec.md's "Isolamento de execução: nsjail" for the full validated finding.
# There is no Swarm anywhere in this deploy (see .ci/readme.md) — the
# frontend (.ci/leetcodeview-fe.service) is a plain container too, joined
# to the same plain bridge network (`leetcodeview-net`) so it can reach
# this one by its `--name`.
#
# Image is built LOCALLY (see deploy.sh), not pulled from a registry —
# there's no registry in this deploy.
[Unit]
Description=code2complexity API
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0

ExecStartPre=-/usr/bin/docker rm -f leetcodeview-api

ExecStart=/usr/bin/docker run --rm --name leetcodeview-api \
  --cap-drop=ALL \
  --cap-add=SYS_ADMIN \
  --cap-add=SYS_CHROOT \
  --cap-add=NET_ADMIN \
  --cap-add=SYS_RESOURCE \
  --cap-add=SETUID \
  --cap-add=SETGID \
  --cap-add=DAC_OVERRIDE \
  --cgroupns=host \
  --security-opt systempaths=unconfined \
  --security-opt seccomp=unconfined \
  -v /sys/fs/cgroup:/sys/fs/cgroup:rw \
  --network leetcodeview-net \
  -p 8080:8080 \
  -e DOTNET_GCHeapHardLimit=0x8000000 \
  leetcodeview:latest

ExecStop=/usr/bin/docker stop -t 15 leetcodeview-api

[Install]
WantedBy=multi-user.target
