# systemd unit for the frontend container (Angular build served by nginx —
# see .ci/Dockerfile.frontend). Plain `docker run`, not a Swarm service —
# there is no Swarm anywhere in this deploy (see .ci/readme.md). No
# elevated privileges needed (just nginx serving a static build and
# reverse-proxying to `leetcodeview-api`), joins the same
# `leetcodeview-net` plain bridge network as the api container (see
# .ci/leetcodeview-api.service) so it can reach it by its `--name` — see
# .ci/nginx.frontend.conf. Image built locally by deploy.sh.
[Unit]
Description=code2complexity frontend
After=docker.service network-online.target leetcodeview-api.service
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0

ExecStartPre=-/usr/bin/docker rm -f leetcodeview-fe

ExecStart=/usr/bin/docker run --rm --name leetcodeview-fe \
  --network leetcodeview-net \
  -p 8081:80 \
  leetcodeview-fe:latest

ExecStop=/usr/bin/docker stop -t 15 leetcodeview-fe

[Install]
WantedBy=multi-user.target
