# Rust (qualquer crate no monorepo: sandbox/, static-analyzer/, etc.)
target/

# .NET build output — scoped to where C# projects actually live, not a
# bare `bin/`/`obj/`: a bare pattern also matches unrelated real source
# dirs elsewhere in the repo (e.g. Rust's own `src/bin/` convention for
# multiple binary targets, used by sandbox/src/bin/sandbox_runner.rs —
# that got silently gitignored and never committed until this was caught).
sandbox/test-snippets-csharp/**/bin/
sandbox/test-snippets-csharp/**/obj/
outdebug/
out/

# Node/frontend (quando existir)
node_modules/
dist/

# Playwright (e2e/)
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# Deploy secrets — real .env files never committed, only the .example
# templates (deploy.sh/deploy-fe.sh source these paths on the VPS, never
# from this repo checkout).
.env
.env.*
!.env.example
!.env.frontend.example

# Editores/SO
.DS_Store
*.swp

# Logs/artefatos de depuração locais
*.log

.quarkus
.claude

.angular