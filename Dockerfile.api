# Combined image: Quarkus API + sandbox-runner (Rust/nsjail) + static-analyzer,
# all in one container.
#
# WHY COMBINED (interim, local-dev only — see tasks.md "Definir contrato/IPC
# entre API e Sandbox Controller"): ProcessSandboxRunner/ProcessStaticAnalyzer
# shell out to these binaries as LOCAL subprocesses (ProcessBuilder, absolute
# paths), not over any network protocol — there's no IPC contract yet. So for
# now the API container needs the binaries on its own filesystem, and needs
# nsjail's privileges (see docker-compose.yml: `privileged: true`) to actually
# sandbox anything. This is explicitly NOT the target production shape (the
# Sandbox Controller running untrusted code shouldn't share a container with
# the public-facing API) — revisit when the real IPC contract is designed.

FROM debian:bookworm-slim AS toolchain

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    flex bison \
    pkg-config \
    libprotobuf-dev protobuf-compiler \
    libnl-route-3-dev \
    libcap-dev \
    libseccomp-dev \
    git \
    curl \
    gnupg \
    ca-certificates \
    libicu-dev \
    python3 \
    maven \
    unzip \
    # uidmap: provides newuidmap/newgidmap, needed by nsjail's
    # --uid_mapping/--gid_mapping (java.rs/csharp.rs) to map the sandboxed
    # process to a REAL non-root uid outside the jail's user namespace.
    # nsjail's simpler --user/--group flags looked sufficient at first but
    # aren't: they always map the inside uid back to nsjail's own (root)
    # uid, and nsjail itself warns about this ("will have user root-level
    # access to files") — confirmed empirically, not just from the log
    # message: reproduced with a manual nsjail run, root DAC access was
    # still real despite getuid()/ps showing "nobody". --uid_mapping maps
    # to a genuinely different, unprivileged outside uid instead.
    uidmap \
    && rm -rf /var/lib/apt/lists/*

# newuidmap/newgidmap refuse to map any range not delegated to the calling
# user via /etc/subuid/subgid, even when that user is real root — confirmed
# empirically (nsjail failed with "gid range ... not allowed" before this).
# Delegates exactly the one uid/gid (65534, nobody/nogroup) java.rs/csharp.rs
# actually map sandboxed executions to.
RUN echo "root:65534:1" > /etc/subuid && echo "root:65534:1" > /etc/subgid

# .NET SDK — same install approach as sandbox/Dockerfile (no apt package)
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet \
    && rm /tmp/dotnet-install.sh
ENV PATH="/usr/share/dotnet:${PATH}"
ENV DOTNET_ROOT="/usr/share/dotnet"

# netcoredbg provides libdbgshim.so, which csharp.rs's ICorDebug worker
# dlopens directly (LIBDBGSHIM_PATH) — netcoredbg itself (the DAP debugger)
# is unused in production (abandoned for a direct ICorDebug interop, see
# spec.md "Estratégia C#"), only this one shared library from its release
# tarball is needed. Missing this entirely (as an earlier version of this
# file did) fails every C# execution with "cannot open shared object file"
# — found by actually running a C# execution against this image, not by
# inspection. linux-arm64 build, matching sandbox/Dockerfile's existing
# pin — same portability caveat applies (not verified on amd64 hosts).
RUN curl -sSL https://github.com/Samsung/netcoredbg/releases/download/3.0.0-1006/netcoredbg-linux-arm64.tar.gz -o /tmp/netcoredbg.tar.gz \
    && mkdir -p /usr/share/netcoredbg \
    && tar -xzf /tmp/netcoredbg.tar.gz -C /usr/share/netcoredbg \
    && rm /tmp/netcoredbg.tar.gz

# nsjail has no apt package — build from source
RUN git clone --depth 1 https://github.com/google/nsjail.git /tmp/nsjail \
    && cd /tmp/nsjail && make \
    && cp nsjail /usr/local/bin/nsjail \
    && cd / && rm -rf /tmp/nsjail

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# JDK 25, used for BOTH the Quarkus API itself AND running sandboxed user
# code (java.rs hardcodes `/usr/bin/java` for the latter). Originally the
# plan was two separate JDKs — this one for Quarkus, an `openjdk-17-jdk-
# headless` install for the sandboxed path, on the assumption jdi/Debugger.
# java needed to "stay JDK 17". That never actually held: `openjdk-17-jdk-
# headless` was installed BEFORE this package in the same apt layer, and
# `update-alternatives` picks the higher-priority (i.e. newer-version)
# package by default — so `/usr/bin/java`/`/usr/bin/javac` silently
# resolved to this JDK 25 install all along, not JDK 17. Found empirically
# (`readlink -f /usr/bin/java` inside a running container, not assumed).
# Some JDI findings in tasks.md (e.g. the InnocuousThreadGroup multi-thread
# false-positive) cite validation against the standalone `sandbox/Dockerfile`
# spike image, which genuinely IS JDK 17 (no competing install there) — but
# the fix has ALSO been continuously exercised against this combined image's
# real JDK 25 the whole time (the E2E suite's multi-thread test runs against
# docker-compose, i.e. this image), so it's confirmed correct under both,
# not misattributed. Since everything already works correctly under JDK 25,
# the openjdk-17 install here was removed instead of forcing JDK 17 to match
# stale intent — one JDK for this image, nothing to keep in sync.
# Quarkus is launched with an explicit JAVA_HOME instead of touching PATH.
# Installed via Eclipse Temurin's own apt repo (verified reachable), not a
# guessed tarball URL. NOTE: `maven` (installed above) transitively pulls in
# `openjdk-17-jre-headless` as a dependency — confirmed harmless via
# `update-alternatives --display java`: it registers at a lower priority
# (1711) than this JDK 25 install (2511), so `/usr/bin/java` still resolves
# here in "auto mode", and being JRE-only it never provides `javac` at all.
# The install dir is architecture-suffixed (temurin-25-jdk-amd64 vs
# -arm64) and differs depending on the build host/platform — symlinked to
# a stable, arch-independent path instead of hardcoding one arch (found by
# actually building this on an arm64 host, where a hardcoded "-amd64" path
# doesn't exist and JAVA_HOME silently points nowhere).
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends temurin-25-jdk \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/jvm/temurin-25-jdk-* /usr/lib/jvm/jdk-25
ENV JDK25_HOME="/usr/lib/jvm/jdk-25"

# ─── Build sandbox-runner + jdi Debugger ──────────────────────────────────
FROM toolchain AS sandbox-build
WORKDIR /build/sandbox
COPY sandbox/ .
RUN cargo build --release
RUN javac -encoding UTF-8 -d /build/jdi-out jdi/Debugger.java

# ─── CDS (Class Data Sharing) archive for the JDI driver ──────────────────
# Reduces per-execution Java cold start (tasks.md "Pool de JVMs pré-
# aquecidas ... ou CDS"). The earlier "Cold start medido com precisão"
# measurement found the ~470ms/execution cost is NOT raw JVM boot (~18ms
# for `java` alone in this same container) but JDWP-handshake-adjacent
# work — confirmed by directly instrumenting class loading
# (-Xlog:class+load=info): of the ~1550 classes a full driver+target run
# touches, ~520 are NOT covered by the JDK's own default/base CDS archive
# (already active automatically, "mixed mode, sharing" — that's what makes
# `newfstat` on lib/server/classes.jsa a REQUIRED syscall in java.rs's
# JAVA_SECCOMP_POLICY, found independently while hardening seccomp). Of
# those ~520, ~310 are the jdk.jdi module (com.sun.jdi.*/com.sun.tools.jdi.*
# — the DRIVER, jdi/Debugger.java, imports this directly) plus ~170 extra
# java.base classes the debug/subprocess-launch path touches — and
# essentially ALL of that gap lives in the DRIVER process specifically: a
# plain debuggee run, even WITH a real JDWP agent attached
# (-agentlib:jdwp), loads only 3-4 classes outside the base archive. See
# java.rs's DRIVER_CDS_JAR/DRIVER_CDS_ARCHIVE comment for why the TARGET jvm
# (LaunchingConnector's child process, running the user's own code)
# deliberately does NOT get an archive of its own — its classpath is a
# different, user-supplied directory on every single execution, which both
# can't be archived (see below) and wouldn't be worth archiving anyway
# given the above.
#
# Mechanism: JDK 25 confirmed (via `java -XX:+PrintFlagsFinal -version |
# grep -i shar` inside the real temurin-25-jdk image, not guessed) to
# support "dynamic CDS archiving" (-XX:ArchiveClassesAtExit, stable since
# JDK 19) — the documented "run your app once, get an archive" successor to
# the older manual -Xshare:dump + classlist workflow, used here instead of
# that older mechanism as the least-fragile option available. `java
# -Xshare:help` (mentioned as one way to probe this) is NOT a real flag on
# this JDK — confirmed empirically ("Unrecognized option"); PrintFlagsFinal
# is what actually enumerates the CDS-related flags.
#
# Requires a JAR on the classpath, NOT an exploded class directory —
# confirmed empirically: pointing -XX:ArchiveClassesAtExit at a directory
# classpath entry fails the dump outright with "Error: non-empty directory
# in paths / Cannot have non-empty directory in paths" (a real JDK
# limitation, tracked upstream as JDK-8304484 — the message is confusing
# but the restriction is real and not a misconfiguration on this project's
# side). That's why Debugger.class gets jar'd up into jdi-driver.jar here
# instead of staying the exploded jdi-out/ directory java.rs used to
# reference directly.
#
# The archive's app-classpath entry is matched by EXACT path string at
# runtime (confirmed empirically: a same-content jar at a different path
# fails "Archived app classpath validation", logged via -Xlog:class+path=
# info) — so the jar is built AND the archive is generated at the SAME
# absolute path ("/app/...") this image's final runtime stage copies it to
# below, not a /build/... path, otherwise the archive would never validate
# and CDS would silently do nothing (see -Xshare:auto in java.rs).
#
# Trained against test-snippets/Trivial.java — the exact snippet the
# original cold-start baseline was measured with — run through the REAL
# Debugger driver end-to-end (spawns an actual target JVM via
# LaunchingConnector, same as production), so the archive captures the
# real class set an actual execution touches, not a guess.
#
# This RUN is a layer AFTER the `javac ... Debugger.java` layer above (not
# moved earlier in the Dockerfile), so normal Docker layer caching (no
# --no-cache needed) already invalidates and regenerates this archive
# whenever Debugger.java's compiled output changes — it depends on
# /build/jdi-out's content via the `jar cf ... -C /build/jdi-out .` below,
# same as any other layer that COPYs/reads a previous layer's output.
#
# `test -s`: fail the BUILD loudly if the archive didn't come out non-empty
# (rather than silently shipping an image java.rs would then reference a
# missing/empty file for) — matches this project's "never assume, validate
# empirically" discipline. Safe to be this strict here specifically because
# java.rs ships with -Xshare:auto (not `on`): even if this whole RUN were
# somehow skipped or its output corrupted post-build, runtime falls back to
# the JDK's own always-present default archive rather than crashing — see
# java.rs's comment on that flag choice.
RUN mkdir -p /app /build/cds-train && \
    jar cf /app/jdi-driver.jar -C /build/jdi-out . && \
    cp test-snippets/Trivial.java /build/cds-train/ && \
    javac -encoding UTF-8 -g -d /build/cds-train /build/cds-train/Trivial.java && \
    java -Xlog:cds -XX:ArchiveClassesAtExit=/app/jdi-driver.jsa \
        -cp /app/jdi-driver.jar Debugger Trivial \
        "-cp /build/cds-train -Xmx256m -XX:MaxMetaspaceSize=64m -XX:MaxDirectMemorySize=256m" && \
    test -s /app/jdi-driver.jsa

# ─── Build static-analyzer ────────────────────────────────────────────────
FROM toolchain AS analyzer-build
WORKDIR /build/static-analyzer
COPY static-analyzer/ .
RUN cargo build --release

# ─── Build the Quarkus API ────────────────────────────────────────────────
FROM toolchain AS api-build
WORKDIR /build/api
COPY api/pom.xml .
COPY api/.mvn .mvn
COPY api/mvnw .
RUN JAVA_HOME=$JDK25_HOME ./mvnw -q -B dependency:go-offline || true
COPY api/src src
RUN JAVA_HOME=$JDK25_HOME ./mvnw -q -B package -DskipTests

# ─── Runtime ───────────────────────────────────────────────────────────────
FROM toolchain
WORKDIR /app

COPY --from=sandbox-build /build/sandbox/target/release/sandbox-runner /app/sandbox-runner
# jdi-driver.jar/.jsa (NOT the old exploded jdi-out/ dir): the JDI driver's
# classpath + its CDS archive — see the sandbox-build stage's own comment
# on the RUN step that generates these, and java.rs's DRIVER_CDS_JAR/
# DRIVER_CDS_ARCHIVE for how they're referenced at runtime. Copied to the
# SAME /app/... path used both when the archive was generated (sandbox-
# build stage, above) and when java.rs invokes java — CDS validates the
# app classpath by exact path string, so this can't be renamed/moved here
# without also regenerating the archive against the new path.
COPY --from=sandbox-build /app/jdi-driver.jar /app/jdi-driver.jar
COPY --from=sandbox-build /app/jdi-driver.jsa /app/jdi-driver.jsa
COPY --from=analyzer-build /build/static-analyzer/target/release/static-analyzer /app/static-analyzer
COPY --from=api-build /build/api/target/quarkus-app /app/quarkus-app

# Minimal, isolated rootfs per sandboxed language (java.rs/csharp.rs --chroot
# target, replacing --chroot / -- see sandbox/build-minimal-rootfs.sh's own
# header comment for the full rationale/derivation, and tasks.md "Filesystem
# temporário/efêmero"). Must run AFTER the COPYs above: it reads
# /app/jdi-driver.jar, /app/jdi-driver.jsa, and /app/sandbox-runner
# (already-built artifacts) to stage them into the new roots, not the
# source tree.
COPY sandbox/build-minimal-rootfs.sh /tmp/build-minimal-rootfs.sh
RUN bash /tmp/build-minimal-rootfs.sh /opt/sandbox-rootfs && rm /tmp/build-minimal-rootfs.sh

ENV SANDBOX_RUNNER_BIN="/app/sandbox-runner"
ENV STATIC_ANALYZER_BIN="/app/static-analyzer"

EXPOSE 8080

CMD ["/usr/lib/jvm/jdk-25/bin/java", "-Dsandbox.runner.binary-path=/app/sandbox-runner", \
     "-Dstatic-analyzer.binary-path=/app/static-analyzer", \
     "-jar", "/app/quarkus-app/quarkus-run.jar"]
